{
  "name": "sports-pickem",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/api",
    "dev:client": "npm run dev --workspace apps/client",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e:client": "npm run e2e --workspace apps/client",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
