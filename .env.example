# Copy to .env for local development. Never commit the real .env file.

# --- Runtime -----------------------------------------------------------
# development | test | staging | production
NODE_ENV=development
# Port the API server listens on.
PORT=3000
# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Database ------------------------------------------------------------
# Postgres connection string. For local dev, point at the docker-compose
# postgres service (see README "Local setup").
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sports_pickem_dev

# --- Sports data provider (JAC-20) -------------------------------------------
# mock  -> no network calls, returns canned/fixture-driven data (default,
#          used in dev and CI so nothing ever hits ESPN)
# live  -> calls the real ESPN site API (staging/prod only) — free and
#          unauthenticated, no key needed. See docs/adr/0003-sports-data-pipeline.md.
SPORTS_API_PROVIDER=mock
# Only for pointing tests/local dev at a stub server. Unset in every real
# environment — the adapter falls back to the real ESPN endpoint.
ESPN_API_BASE_URL=

# --- Observability (JAC-11) -------------------------------------------------
# Sentry DSN for error tracking. Unset -> error tracking is a no-op
# (dev/CI never send anything anywhere). Set per-environment in staging/prod.
SENTRY_DSN=
# Dead-man's-switch URL (e.g. a healthchecks.io check) pinged by score-poll
# on every run — the DEDICATED alert for background job failure. Fires both
# on an explicit job error and when the job simply never runs at all, which
# error tracking alone can't catch. Unset -> ping is a no-op.
HEARTBEAT_URL=
# Separate dead-man's-switch for the schedule-ingest job (JAC-24) — it runs
# every 4 hours, not every 5 minutes, so sharing HEARTBEAT_URL would make
# "did it run on time" meaningless for both jobs. Unset -> ping is a no-op.
SCHEDULE_INGEST_HEARTBEAT_URL=
# Separate dead-man's-switch for the golf-ingest job (JAC-56) — runs every
# 15 minutes on its own cadence. Unset -> ping is a no-op.
GOLF_INGEST_HEARTBEAT_URL=

# --- Auth (JAC-13-18) -------------------------------------------------------
# Opaque, DB-backed access + refresh tokens (not JWT) — see
# docs/adr/0002-auth-session-hashing-email.md. Access token is short-lived;
# refresh token has a SLIDING expiry (extended on every refresh), so an
# actively-returning user is never forced to re-authenticate.
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=90
# Verification/reset token lifetimes.
AUTH_EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
AUTH_EMAIL_CHANGE_TOKEN_TTL_HOURS=24
AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Self-serve account deletion grace period — see docs/account-anonymization.md.
ACCOUNT_DELETION_GRACE_PERIOD_DAYS=30
# Separate dead-man's-switch from HEARTBEAT_URL above: this job runs daily,
# not every 5 minutes, so sharing one monitor would make "did it run on
# time" meaningless for both jobs. Unset -> ping is a no-op.
ANONYMIZATION_HEARTBEAT_URL=

# --- Email provider (JAC-15) -------------------------------------------------
# mock   -> no network calls, logs the verification/reset link instead so a
#           dev can grab it from `npm run dev` output (default, used in dev
#           and CI — no Resend account needed for local setup)
# resend -> sends real email via Resend (staging/prod only)
EMAIL_PROVIDER=mock
# Required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# Used to build absolute links in emails (e.g. verification links). Set
# this per-environment once you know the real deployed URL.
PUBLIC_API_URL=http://localhost:3000
# The client's own origin (Epic 8/JAC-43-48+ client infrastructure) —
# CORS allows exactly this one origin. Defaults to apps/client's local
# dev Vite port. Set this per-environment once the client is deployed
# somewhere real.
PUBLIC_CLIENT_URL=http://localhost:5173

# --- Leagues and membership (JAC-25-30) --------------------------------------
# Global guardrails, not per-league commissioner-configurable settings —
# see docs/leagues-and-membership.md.
MAX_LEAGUE_MEMBERS=100
MAX_LEAGUES_PER_USER=25

# --- Scoring and standings (JAC-37-42) ---------------------------------------
# How long after a game finalizes score-poll keeps re-checking it for a
# provider-side revision. See docs/scoring-and-standings.md.
REVISION_CHECK_WINDOW_HOURS=48

# --- Rate limiting and caching (JAC-43-48) ------------------------------------
# See docs/rate-limiting-and-caching.md for the full design of every
# limit below, and why each one needs its own independent registration.
ACCOUNT_RATE_LIMIT_PER_MINUTE=300
PICK_WRITE_RATE_LIMIT_PER_MINUTE=30
SIGNUP_DAILY_LIMIT_PER_IP=20
SLATE_CACHE_TTL_SECONDS=20
SLATE_POLL_RATE_LIMIT_PER_MINUTE=20

# --- Notifications (JAC-43-48) ------------------------------------------------
# See docs/notifications.md. How long before a league's first lock of
# the day the pick-reminder job sends.
REMINDER_LEAD_TIME_MINUTES=60
# Separate dead-man's-switches, same reasoning as HEARTBEAT_URL above —
# each notification job runs on its own schedule.
PICK_REMINDER_HEARTBEAT_URL=
RESULTS_SUMMARY_HEARTBEAT_URL=

# --- Closed-beta observability (JAC-43-48) ------------------------------------
# See docs/notifications.md and jobs/operator-digest.ts. Single static
# recipient for the daily ops digest email. Unset -> the digest job is
# a no-op with a warning log.
OPERATOR_EMAIL=
OPERATOR_DIGEST_HEARTBEAT_URL=
