# Copy to .env for local development. Never commit the real .env file.

# --- Runtime -----------------------------------------------------------
# development | test | staging | production
NODE_ENV=development
# Port the API server listens on.
PORT=3000
# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Database ------------------------------------------------------------
# Postgres connection string. For local dev, point at the docker-compose
# postgres service (see README "Local setup").
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sports_pickem_dev

# --- Sports data provider -------------------------------------------------
# mock  -> no network calls, returns canned/seed-driven data (default, used
#          in dev and CI so nothing ever hits the paid API or burns quota)
# live  -> calls the real paid sports-data API (staging/prod only)
SPORTS_API_PROVIDER=mock
# Required only when SPORTS_API_PROVIDER=live.
SPORTS_API_BASE_URL=
SPORTS_API_KEY=

# --- Scheduled jobs --------------------------------------------------------
# Cron expression for the score-poll job. Only read by the Render Cron Job
# config for reference locally; the actual schedule is set in render.yaml.
SCORE_POLL_INTERVAL_CRON="*/5 * * * *"

# --- Observability (JAC-11) -------------------------------------------------
# Sentry DSN for error tracking. Unset -> error tracking is a no-op
# (dev/CI never send anything anywhere). Set per-environment in staging/prod.
SENTRY_DSN=
# Dead-man's-switch URL (e.g. a healthchecks.io check) pinged by score-poll
# on every run — the DEDICATED alert for background job failure. Fires both
# on an explicit job error and when the job simply never runs at all, which
# error tracking alone can't catch. Unset -> ping is a no-op.
HEARTBEAT_URL=
