# Loaded ahead of .env whenever Vitest is running (see apps/api/src/lib/env.ts).
# Committed on purpose: it holds no secrets, and every dev needs the same
# protection from the default it overrides.
#
# The API's integration tests truncate every table between cases. Pointing
# them at the dev database means losing the dev database — its leagues, its
# picks, and the college quiz's player pool. So they get their own, and
# env.ts refuses to start a test run unless this name ends in "_test".
#
# Create it once:
#   docker compose exec postgres createdb -U postgres sports_pickem_test
#
# Migrations are applied automatically before the suite runs
# (apps/api/vitest.global-setup.ts). See CONTRIBUTING.md.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sports_pickem_test

# Anything not set here falls through to .env, since dotenv never overwrites
# an already-set value. CI sets DATABASE_URL in the job env, which beats
# this file entirely.
NODE_ENV=test
