{
  "name": "@sports-pickem/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "score-poll": "node dist/jobs/score-poll.js",
    "schedule-ingest": "node dist/jobs/schedule-ingest.js",
    "anonymize-accounts": "node dist/jobs/anonymize-accounts.js",
    "pick-reminder": "node dist/jobs/pick-reminder.js",
    "results-summary": "node dist/jobs/results-summary.js",
    "operator-digest": "node dist/jobs/operator-digest.js",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^10.70.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "luxon": "^3.5.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "resend": "^6.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^4.1.10"
  }
}
