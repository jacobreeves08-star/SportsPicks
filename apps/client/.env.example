# Copy to .env for local development, or set as real env vars at build
# time for a staging/prod build. Vite only exposes VITE_-prefixed vars
# to client code (everything else is stripped from the bundle).

# Base URL of the API this client talks to. Defaults to
# http://localhost:3000 (apps/api's local dev port) if unset, so local
# dev works with zero config — see src/api/config.ts.
VITE_API_BASE_URL=http://localhost:3000
